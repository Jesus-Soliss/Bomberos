@model EmergenciaViewModel
@{
    var nueva = Model.Id == 0;
    ViewData["Title"] = nueva ? "Registrar emergencia" : $"Editar emergencia N.º {Model.Id}";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(nueva ? "Crear" : "Editar")" method="post" class="row g-3" style="max-width: 46rem">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-md-6">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Formato.Opciones<TipoEmergencia>()" class="form-select">
            <option value="">Seleccione…</option>
        </select>
        <span asp-validation-for="Tipo" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Prioridad" class="form-label"></label>
        <select asp-for="Prioridad" asp-items="Formato.Opciones<PrioridadEmergencia>()" class="form-select">
            <option value="">Seleccione…</option>
        </select>
        <span asp-validation-for="Prioridad" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-danger">@(nueva ? "Registrar emergencia" : "Guardar cambios")</button>
        @* El cliente no tiene listado al que volver. *@
        @if (nueva && !User.EsCliente())
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        }
        else if (!nueva)
        {
            <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.Id">Cancelar</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
