@model List<AuditLogDto>
@{
    ViewData["Title"] = "Auditoría";
    var usuarios = (Dictionary<string, string>)ViewBag.Usuarios;
}

<h1 class="h3 mb-1">Auditoría</h1>
<p class="text-muted">Acciones de los usuarios en el sistema central. Se muestran las 300 más recientes que cumplen el filtro.</p>

<partial name="_Filtro" model="(LogFiltroViewModel)ViewBag.Filtro" />

<div class="table-responsive">
    <table class="table table-sm table-hover">
        <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>N.º</th><th>Resultado</th></tr></thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td class="text-nowrap">@l.FechaHora.Fecha()</td>
                    <td>@(l.UsuarioId is null ? "—" : usuarios.GetValueOrDefault(l.UsuarioId, l.UsuarioId))</td>
                    <td>@l.Accion</td>
                    <td>@l.Entidad</td>
                    <td>@(l.EntidadId?.ToString() ?? "—")</td>
                    <td>@Html.Estado(l.Resultado)</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No hay registros que coincidan con los filtros.</td></tr>
            }
        </tbody>
    </table>
</div>
