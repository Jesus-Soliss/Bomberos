@model LogFiltroViewModel
@{
    var usuarios = (List<SelectListItem>)ViewBag.UsuariosLista;
    var etiquetaAccion = (string)(ViewData["EtiquetaAccion"] ?? "Acción");
}

<form asp-action="@ViewContext.RouteData.Values["action"]" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-6 col-md-3">
        <label for="UsuarioId" class="form-label small mb-1">Usuario</label>
        <select id="UsuarioId" name="UsuarioId" class="form-select form-select-sm" asp-items="usuarios">
            <option value="">Todos</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label for="Accion" class="form-label small mb-1">@etiquetaAccion</label>
        <input type="text" id="Accion" name="Accion" value="@Model.Accion" class="form-control form-control-sm" />
    </div>
    <div class="col-6 col-md-auto">
        <label for="Desde" class="form-label small mb-1">Desde</label>
        <input type="date" id="Desde" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-6 col-md-auto">
        <label for="Hasta" class="form-label small mb-1">Hasta</label>
        <input type="date" id="Hasta" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
        <a class="btn btn-sm btn-outline-secondary" asp-action="@ViewContext.RouteData.Values["action"]">Limpiar</a>
    </div>
</form>
