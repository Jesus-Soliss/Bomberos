@model EstacionViewModel
@{
    var nueva = Model.Id == 0;
    ViewData["Title"] = nueva ? "Nueva estación" : "Editar estación";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(nueva ? "Crear" : "Editar")" method="post" class="row g-3" style="max-width: 40rem">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-12">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
        <span asp-validation-for="Direccion" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-danger">@(nueva ? "Crear estación" : "Guardar cambios")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
