@model List<EstacionDto>
@{
    ViewData["Title"] = "Estaciones";
    var admin = User.EsAdministrador();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Estaciones</h1>
    @if (admin)
    {
        <a class="btn btn-danger" asp-action="Crear">Nueva estación</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Nombre</th><th>Dirección</th><th>Teléfono</th><th>Estado</th>@if (admin) { <th class="text-end">Acciones</th> }</tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                var activa = e.Estado == EstadoEstacion.Activa;
                <tr>
                    <td class="fw-semibold">@e.Nombre</td>
                    <td>@e.Direccion</td>
                    <td>@(e.Telefono ?? "—")</td>
                    <td>@Html.Estado(e.Estado)</td>
                    @if (admin)
                    {
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@e.Id">Editar</a>
                            <form asp-action="CambiarEstado" asp-route-id="@e.Id" method="post" class="d-inline"
                                  data-confirm="@(activa ? $"¿Inactivar la estación {e.Nombre}?" : $"¿Activar la estación {e.Nombre}?")">
                                <input type="hidden" name="estado" value="@(activa ? EstadoEstacion.Inactiva : EstadoEstacion.Activa)" />
                                <button type="submit" class="btn btn-sm @(activa ? "btn-outline-danger" : "btn-outline-success")">@(activa ? "Inactivar" : "Activar")</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No hay estaciones para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>
