@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 text-danger">Ocurrió un error</h1>
<p>No se pudo procesar la solicitud. Intente de nuevo; si el problema continúa, comuníquese con el administrador.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">Identificador de la solicitud: <code>@Model.RequestId</code></p>
}

<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
