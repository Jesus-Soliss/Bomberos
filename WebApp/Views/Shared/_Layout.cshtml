@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    string Activo(string controller) => (string?)ViewContext.RouteData.Values["controller"] == controller ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bomberos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bomberos.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-bomberos mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Bomberos · Emergencias</a>
                @if (autenticado)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                            aria-controls="menu" aria-expanded="false" aria-label="Mostrar menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menu">
                        <ul class="navbar-nav me-auto">
                            @if (User.EsCliente())
                            {
                                <li class="nav-item"><a class="nav-link active" asp-controller="Emergencias" asp-action="Crear">Registrar emergencia</a></li>
                            }
                            else
                            {
                                <text>
                            <li class="nav-item"><a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Emergencias")" asp-controller="Emergencias" asp-action="Index">Emergencias</a></li>
                            @if (User.PuedeOperar())
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Emergencias" asp-action="Index" asp-route-Origen="Central911">Recibidas del 911</a></li>
                            }
                            <li class="nav-item"><a class="nav-link @Activo("Estaciones")" asp-controller="Estaciones" asp-action="Index">Estaciones</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Bomberos")" asp-controller="Bomberos" asp-action="Index">Bomberos</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Vehiculos")" asp-controller="Vehiculos" asp-action="Index">Vehículos</a></li>
                            @if (User.EsAdministrador())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @Activo("Usuarios") @Activo("Roles") @Activo("Auditoria")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Perfiles</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Index">Auditoría</a></li>
                                        <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Peticiones">Log de peticiones</a></li>
                                        <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Pendientes">Operaciones pendientes</a></li>
                                    </ul>
                                </li>
                            }
                                </text>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="navbar-text text-white">
                                @User.NombreCompleto() <span class="badge bg-light text-dark ms-1">@Formato.Etiqueta(User.RolPrincipal())</span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @foreach (var (clave, clase) in new[] { ("Exito", "success"), ("Aviso", "info"), ("Error", "danger") })
            {
                var mensaje = TempData[clave] as string ?? ViewData[clave] as string;
                if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert alert-@clase alert-dismissible fade show" role="alert">
                        @mensaje
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Sistema de Gestión de Emergencias de Bomberos
        </div>
    </footer>

    @* Confirmación de las acciones críticas: cualquier <form data-confirm="..."> pasa por este modal. *@
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalConfirmarTitulo">Confirmar acción</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalConfirmarMensaje"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
                    <button type="button" class="btn btn-danger" id="modalConfirmarAceptar">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
