@model List<BomberoDto>
@{
    ViewData["Title"] = "Bomberos";
    var admin = User.EsAdministrador();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bomberos</h1>
    @if (admin)
    {
        <a class="btn btn-danger" asp-action="Crear">Nuevo bombero</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Nombre</th><th>Cédula</th><th>Rango</th><th>Estación</th><th>Estado</th><th>Disponibilidad</th>@if (admin) { <th class="text-end">Acciones</th> }</tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                var activo = b.Estado == EstadoBombero.Activo;
                <tr>
                    <td class="fw-semibold">@b.Nombre @b.Apellido</td>
                    <td>@b.Cedula</td>
                    <td>@b.Rango.Etiqueta()</td>
                    <td>@b.EstacionNombre</td>
                    <td>@Html.Estado(b.Estado)</td>
                    <td>@(activo ? Html.Estado(b.EnServicio ? "EN_SERVICIO" : "DISPONIBLE") : Html.Raw("—"))</td>
                    @if (admin)
                    {
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@b.Id">Editar</a>
                            <form asp-action="CambiarEstado" asp-route-id="@b.Id" method="post" class="d-inline"
                                  data-confirm="@(activo ? $"¿Inactivar a {b.Nombre} {b.Apellido}? No podrá recibir asignaciones." : $"¿Activar a {b.Nombre} {b.Apellido}?")">
                                <input type="hidden" name="estado" value="@(activo ? EstadoBombero.Inactivo : EstadoBombero.Activo)" />
                                <button type="submit" class="btn btn-sm @(activo ? "btn-outline-danger" : "btn-outline-success")">@(activo ? "Inactivar" : "Activar")</button>
                            </form>
                        </td>
                    }
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No hay bomberos para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>
