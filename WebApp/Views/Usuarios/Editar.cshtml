@model UsuarioEditarViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<h1 class="h3 mb-3">Editar usuario <span class="text-muted">@Model.Username</span></h1>

<form asp-action="Editar" method="post" class="row g-3" style="max-width: 46rem">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Username" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-danger">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
