@model List<UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
    var roles = (List<SelectListItem>)ViewBag.Roles;
    var yo = User.FindFirst("sub")?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios</h1>
    <a class="btn btn-danger" asp-action="Crear">Nuevo usuario</a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Usuario</th><th>Nombre</th><th>Correo</th><th>Perfil</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                var esYo = u.Id == yo;
                var activo = u.Estado == EstadosUsuario.Activo;
                <tr class="@(activo ? "" : "table-secondary")">
                    <td class="fw-semibold">@u.Username @if (esYo) { <span class="badge bg-dark">usted</span> }</td>
                    <td>@u.Nombre @u.Apellido</td>
                    <td>@u.Email</td>
                    <td>
                        @if (esYo)
                        {
                            @* RN-16: el administrador no cambia su propio rol *@
                            <span class="badge bg-secondary">@Formato.Etiqueta(u.Rol ?? "")</span>
                        }
                        else
                        {
                            <form asp-action="CambiarRol" asp-route-id="@u.Id" method="post" class="d-flex gap-1"
                                  data-confirm="¿Cambiar el perfil de @u.Username?">
                                <select name="rol" class="form-select form-select-sm" aria-label="Perfil de @u.Username">
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r.Value" selected="@(r.Value == u.Rol)">@Formato.Etiqueta(r.Text)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Cambiar</button>
                            </form>
                        }
                    </td>
                    <td>@Html.Estado(u.Estado)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@u.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="RestablecerPassword" asp-route-id="@u.Id">Contraseña</a>
                        @if (!esYo)
                        {
                            <form asp-action="CambiarEstado" asp-route-id="@u.Id" method="post" class="d-inline"
                                  data-confirm="@(activo ? $"¿Inactivar a {u.Username}? No podrá iniciar sesión." : $"¿Activar a {u.Username}?")">
                                <input type="hidden" name="estado" value="@(activo ? EstadosUsuario.Inactivo : EstadosUsuario.Activo)" />
                                <button type="submit" class="btn btn-sm @(activo ? "btn-outline-danger" : "btn-outline-success")">@(activo ? "Inactivar" : "Activar")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No hay usuarios para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>
