@model RestablecerPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<h1 class="h3 mb-3">Restablecer contraseña de <span class="text-muted">@Model.Username</span></h1>

<form asp-action="RestablecerPassword" method="post" class="row g-3" style="max-width: 30rem"
      data-confirm="¿Restablecer la contraseña de @Model.Username? La contraseña actual dejará de funcionar.">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Username" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-12">
        <label asp-for="NuevaPassword" class="form-label"></label>
        <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
        <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>
        <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-danger">Restablecer contraseña</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
