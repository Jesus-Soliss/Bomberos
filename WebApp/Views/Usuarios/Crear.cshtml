@model UsuarioCrearViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
    var roles = ((List<SelectListItem>)ViewBag.Roles).Select(r => new SelectListItem(Formato.Etiqueta(r.Text), r.Value));
}

<h1 class="h3 mb-3">Nuevo usuario</h1>

<form asp-action="Crear" method="post" class="row g-3" style="max-width: 46rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="col-md-6">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" autocomplete="off" />
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" asp-items="roles" class="form-select">
            <option value="">Seleccione…</option>
        </select>
        <span asp-validation-for="Rol" class="text-danger small"></span>
    </div>
    <div class="col-md-6"></div>
    <div class="col-md-6">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-danger">Crear usuario</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
